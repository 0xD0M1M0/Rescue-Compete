# Copy to .env and adjust values:
#   cp .env.example .env

# --- Database (required for Docker Compose) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=webappdb
MYSQL_USER=rescue
MYSQL_PASSWORD=change-me-user

# --- OIDC / SSO (optional) ---
# Leave OIDC_ENABLED=0 for local password login only.
# With Keycloak overlay (docker-compose.keycloak.yml), these are overridden by Compose.
# For a real IdP (e.g. drkserver), set values here and start without the Keycloak file.
OIDC_ENABLED=0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Button label on the login page (default in code: "Mit SSO anmelden")
OIDC_LOGIN_LABEL=Mit SSO anmelden
